<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParetoApp"
        x:Class="ParetoApp.PlanMyWeekWindow"
        Title="Plan My Week"
        Width="550"
        Height="650"
        WindowStartupLocation="CenterOwner">
    
    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Set duration or interval for each task:" FontWeight="Bold" Margin="0,0,0,10" />
            
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10">
                <ScrollViewer MaxHeight="180">
                    <ItemsControl ItemsSource="{Binding MasterTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PlannedTask">
                                <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                                    <TextBlock Grid.Column="0" Text="{Binding TaskName}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,15,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding TimeInterval}" Watermark="e.g. 1h or 14:00-15:00" Width="180" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            
            <Button Content="Apply to All Days" Click="OnApplyToAllClicked" Margin="0,10,0,0" HorizontalAlignment="Right" />
        </StackPanel>

        <!-- zone scroll for days and tasks -->
        <ScrollViewer Grid.Row="1" Padding="0,0,15,0">
            <ItemsControl ItemsSource="{Binding WeekDays}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DayPlan">
                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,0,0,20" Padding="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding DayName}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2E7D32" />
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:PlannedTask">
                                            <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                                                <TextBlock Grid.Column="0" Text="{Binding TaskName}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,15,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding TimeInterval}" Watermark="e.g. 14:00 - 15:00 (or 2h)" Width="200" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Center" Margin="0,15,0,0" Click="OnCloseClicked" />
    </Grid>
</Window>