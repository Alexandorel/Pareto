<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ParetoApp.MainWindow"
        Title="Pareto"
        Width="900"
        Height="800">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BoardCriticalBg" Color="#FFFAFA" />
                    <SolidColorBrush x:Key="BoardMajorBg"    Color="#FFFDF5" />
                    <SolidColorBrush x:Key="BoardMinorBg"    Color="#FFFEF0" />
                    <SolidColorBrush x:Key="BoardDeferredBg" Color="#F5FFF7" />
                    <SolidColorBrush x:Key="BoardCardBorder" Color="Gray" />
                    <SolidColorBrush x:Key="BoardTextFg"     Color="Black" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BoardCriticalBg" Color="Black" />
                    <SolidColorBrush x:Key="BoardMajorBg"    Color="Black" />
                    <SolidColorBrush x:Key="BoardMinorBg"    Color="Black" />
                    <SolidColorBrush x:Key="BoardDeferredBg" Color="Black" />
                    <SolidColorBrush x:Key="BoardCardBorder" Color="White" />
                    <SolidColorBrush x:Key="BoardTextFg"     Color="White" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="CheckBox /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BoardTextFg}" />
        </Style>
        <Style Selector="CheckBox:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BoardTextFg}" />
        </Style>
        <Style Selector="CheckBox:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BoardTextFg}" />
        </Style>
    </Window.Styles>

    <!-- Principal Layout -->
    <SplitView DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="200">

        <!-- Vertical Menu -->
        <SplitView.Pane>
            <StackPanel Margin="10" Spacing="10">
                <Button Content="General" HorizontalAlignment="Stretch" CornerRadius="8" Click="OnGeneralClicked" />
                <Button Content="Pareto Board" HorizontalAlignment="Stretch" CornerRadius="8" />
                <ItemsControl x:Name="BoardsList" ItemsSource="{Binding SavedBoards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="10,2,0,0"
                                    CornerRadius="6"
                                    Click="OnBoardClicked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </SplitView.Pane>

        <!-- Content -->
        <SplitView.Content>
            <Grid RowDefinitions="*, Auto" Margin="20">
                <Grid Grid.Row="0">

                    <!-- General view (creation / editing) -->
                    <StackPanel x:Name="GeneralPanel" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <UniformGrid Columns="2">
                            <Border x:Name="CardCritical" DragDrop.AllowDrop="True" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" MinHeight="150" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="Critical" FontSize="20" FontWeight="Bold" />
                                    <ItemsControl x:Name="CriticalTasks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFCDD2" CornerRadius="4" Padding="8" Margin="0,5,0,0" PointerPressed="OnTaskPointerPressed" Cursor="Hand">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="Black" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardMajor" DragDrop.AllowDrop="True" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" MinHeight="150" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="Major" FontSize="20" FontWeight="Bold" />
                                    <ItemsControl x:Name="MajorTasks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFE082" CornerRadius="4" Padding="8" Margin="0,5,0,0" PointerPressed="OnTaskPointerPressed" Cursor="Hand">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="Black" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardMinor" DragDrop.AllowDrop="True" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" MinHeight="150" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="Minor" FontSize="20" FontWeight="Bold" />
                                    <ItemsControl x:Name="MinorTasks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFF59D" CornerRadius="4" Padding="8" Margin="0,5,0,0" PointerPressed="OnTaskPointerPressed" Cursor="Hand">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="Black" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardDeferred" DragDrop.AllowDrop="True" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" MinHeight="150" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="Deferred" FontSize="20" FontWeight="Bold" />
                                    <ItemsControl x:Name="DeferredTasks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#C8E6C9" CornerRadius="4" Padding="8" Margin="0,5,0,0" PointerPressed="OnTaskPointerPressed" Cursor="Hand">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="Black" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="10,10,10,0">
                            <Button Content="Plan my week" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnPlanMyWeekClicked" />

                            <Button x:Name="TrashCan" DragDrop.AllowDrop="True" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="🗑️" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Trash" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="10,10,10,10" VerticalAlignment="Center">
                            <TextBlock Text="Tasks:" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="TaskInput" Watermark="Enter new task" Width="300" Height="35" VerticalContentAlignment="Center" />
                            <Button Content="Add Task" Margin="10,0,0,0" Click="OnAddTaskClicked" />
                        </StackPanel>

                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="10" Margin="10,0,10,10" MinHeight="100">
                            <ItemsControl x:Name="UnassignedTasks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#E0E0E0" CornerRadius="4" Padding="10" Margin="0,5,0,0" PointerPressed="OnTaskPointerPressed" Cursor="Hand">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="Black" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="10,0,10,5" VerticalAlignment="Center">
                            <TextBlock Text="Board:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="BoardNameInput" Watermark="Enter board name" Width="250" Height="35" VerticalContentAlignment="Center" />
                            <Button Content="💾 Save as Board" Margin="10,0,0,0" Click="OnSaveAsBoardClicked" />
                            <Button Content="🧹 Clear" Margin="10,0,0,0" Click="OnClearClicked" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Pareto Board view (checkbox mode) -->
                    <StackPanel x:Name="ParetoBoardPanel" IsVisible="False" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <TextBlock x:Name="BoardTitleText" FontSize="24" FontWeight="Bold" Margin="10,0,0,15" />

                        <UniformGrid Columns="2">
                            <Border BorderBrush="{DynamicResource BoardCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="280" MinHeight="150" Background="{DynamicResource BoardCriticalBg}">
                                <StackPanel>
                                    <TextBlock Text="Critical" FontSize="20" FontWeight="Bold" Foreground="#E53935" />
                                    <ItemsControl x:Name="BoardCriticalList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Completed, Mode=TwoWay}" Content="{Binding Text}" Margin="0,4,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource BoardCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="280" MinHeight="150" Background="{DynamicResource BoardMajorBg}">
                                <StackPanel>
                                    <TextBlock Text="Major" FontSize="20" FontWeight="Bold" Foreground="#FB8C00" />
                                    <ItemsControl x:Name="BoardMajorList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Completed, Mode=TwoWay}" Content="{Binding Text}" Margin="0,4,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource BoardCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="280" MinHeight="150" Background="{DynamicResource BoardMinorBg}">
                                <StackPanel>
                                    <TextBlock Text="Minor" FontSize="20" FontWeight="Bold" Foreground="#FBC02D" />
                                    <ItemsControl x:Name="BoardMinorList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Completed, Mode=TwoWay}" Content="{Binding Text}" Margin="0,4,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource BoardCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="280" MinHeight="150" Background="{DynamicResource BoardDeferredBg}">
                                <StackPanel>
                                    <TextBlock Text="Deferred" FontSize="20" FontWeight="Bold" Foreground="#66BB6A" />
                                    <ItemsControl x:Name="BoardDeferredList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Completed, Mode=TwoWay}" Content="{Binding Text}" Margin="0,4,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                </Grid>

                <TextBlock x:Name="StatusText" Grid.Row="1" Margin="10,5,10,0" Foreground="#555" FontStyle="Italic" />
            </Grid>
        </SplitView.Content>
    </SplitView>
</Window>
