<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ParetoApp.MainWindow"
        Title="Pareto"
        Width="900"
        Height="800">

    <!-- Principal Layout -->
    <SplitView DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="200">
        
        <!-- Vertical Menu -->
        <SplitView.Pane>
            <StackPanel Margin="10" Spacing="10">
                <Button Content="General" HorizontalAlignment="Stretch" CornerRadius="8" />
            </StackPanel>
        </SplitView.Pane>

        <!-- Content -->
        <SplitView.Content>
            <StackPanel Margin="20" VerticalAlignment="Top" HorizontalAlignment="Left">
                <UniformGrid Columns="2">
                <Border x:Name="CardCritical" DragDrop.AllowDrop="True" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" MinHeight="150" Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="Critical" FontSize="20" FontWeight="Bold" />
                        <ItemsControl x:Name="CriticalTasks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFCDD2" CornerRadius="4" Padding="8" Margin="0,5,0,0" PointerPressed="OnTaskPointerPressed" Cursor="Hand">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="CardMajor" DragDrop.AllowDrop="True" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" MinHeight="150" Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="Major" FontSize="20" FontWeight="Bold" />
                        <ItemsControl x:Name="MajorTasks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFE082" CornerRadius="4" Padding="8" Margin="0,5,0,0" PointerPressed="OnTaskPointerPressed" Cursor="Hand">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="CardMinor" DragDrop.AllowDrop="True" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" MinHeight="150" Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="Minor" FontSize="20" FontWeight="Bold" />
                        <ItemsControl x:Name="MinorTasks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF59D" CornerRadius="4" Padding="8" Margin="0,5,0,0" PointerPressed="OnTaskPointerPressed" Cursor="Hand">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="CardDeferred" DragDrop.AllowDrop="True" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" MinHeight="150" Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="Deferred" FontSize="20" FontWeight="Bold" />
                        <ItemsControl x:Name="DeferredTasks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#C8E6C9" CornerRadius="4" Padding="8" Margin="0,5,0,0" PointerPressed="OnTaskPointerPressed" Cursor="Hand">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </UniformGrid>
                
                <Grid Margin="10,10,10,0">
                    <Button Content="Plan my week" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnPlanMyWeekClicked" />
                    
                    <Button x:Name="TrashCan" DragDrop.AllowDrop="True" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="🗑️" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Trash" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="10,10,10,10" VerticalAlignment="Center">
                    <TextBlock Text="Tasks:" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="TaskInput" Watermark="Enter new task" Width="300" Height="35" VerticalContentAlignment="Center" />
                    <Button Content="Add Task" Margin="10,0,0,0" Click="OnAddTaskClicked" />
                </StackPanel>
                
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="10" Margin="10,0,10,10" MinHeight="100">
                    <ItemsControl x:Name="UnassignedTasks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E0E0E0" CornerRadius="4" Padding="10" Margin="0,5,0,0" PointerPressed="OnTaskPointerPressed" Cursor="Hand">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </SplitView.Content>
    </SplitView>
</Window>