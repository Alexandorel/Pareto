<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ParetoApp.MainWindow"
        Title="Pareto"
        Width="900"
        Height="800">

    <!-- Principal Layout -->
    <SplitView DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="200">
        
        <!-- Vertical Menu -->
        <SplitView.Pane>
            <StackPanel Margin="10" Spacing="10">
                <Button Content="General" HorizontalAlignment="Stretch" CornerRadius="8" />
            </StackPanel>
        </SplitView.Pane>

        <!-- Content -->
        <SplitView.Content>
            <StackPanel Margin="20" VerticalAlignment="Top" HorizontalAlignment="Left">
                <UniformGrid Columns="2">
                <!-- Card 1 -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" Height="150">
                    <StackPanel>
                        <TextBlock Text="Critical" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Card 2 -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" Height="150">
                    <StackPanel>
                        <TextBlock Text="Major" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Card 3 -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" Height="150">
                    <StackPanel>
                        <TextBlock Text="Minor" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Card 4 -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10" Width="250" Height="150">
                    <StackPanel>
                        <TextBlock Text="Deferred" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                </UniformGrid>
                
                <!-- Tasks Label -->
                <StackPanel Orientation="Horizontal" Margin="10,20,10,10" VerticalAlignment="Center">
                    <TextBlock Text="Tasks:" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Watermark="Enter new task" Width="300" Height="35" VerticalContentAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </SplitView.Content>
    </SplitView>
</Window>